# Copy to .env. Bun reads .env on its own; `bun run start` passes it to Node.

# From aistudio.google.com. Server-side only: never put it in web/.
GEMINI_API_KEY=

# The Google OAuth client (console.cloud.google.com, APIs and services,
# Credentials). Redirect URI: <PUBLIC_URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where people reach the app. Unset in development: the request's own
# address is used (http://localhost:3220 through Vite).
# PUBLIC_URL=https://quiz.okyle.dev

# Sign-in codes go out from a Gmail account over SMTP. MAIL_APP_PASSWORD is
# an app password (Google Account, Security, 2-Step Verification, App
# passwords), not the account's own password; the spaces Google shows in it
# can stay. Unset in development: codes print in the server's log instead.
# A production server without them refuses email sign-in. EMAIL_USER and
# EMAIL_PASSWORD are read under those names too; MAIL_FROM is the sender shown
# (a verified Gmail alias works).
# MAIL_USER=
# MAIL_APP_PASSWORD=
# MAIL_FROM="QuizApp <you@gmail.com>"

# SQLite file. A postgres:// or mysql:// URL works too.
DB_URL=./data/silid.db

PORT=3221
