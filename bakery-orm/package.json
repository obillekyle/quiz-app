{
  "name": "bakery-orm",
  "version": "2.0.4",
  "private": true,
  "description": "Bakery's ORM on its own: the query builder, the three adapters and schema sync, running on Bun and on Node.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./src/adapters.ts",
      "bun": "./src/adapters.ts",
      "default": "./dist/adapters.js"
    },
    "./backup": {
      "types": "./src/backup.ts",
      "bun": "./src/backup.ts",
      "default": "./dist/backup.js"
    },
    "./connection": {
      "types": "./src/connection.ts",
      "bun": "./src/connection.ts",
      "default": "./dist/connection.js"
    },
    "./orm": {
      "types": "./src/orm/index.ts",
      "bun": "./src/orm/index.ts",
      "default": "./dist/orm/index.js"
    },
    "./pool": {
      "types": "./src/pool.ts",
      "bun": "./src/pool.ts",
      "default": "./dist/pool.js"
    },
    "./schema-registry": {
      "types": "./src/schema-registry.ts",
      "bun": "./src/schema-registry.ts",
      "default": "./dist/schema-registry.js"
    },
    "./schema-util": {
      "types": "./src/schema-util.ts",
      "bun": "./src/schema-util.ts",
      "default": "./dist/schema-util.js"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "bun": "./src/sync/index.ts",
      "default": "./dist/sync/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --preload ./src/tests/sweep-preload.ts ./src",
    "test:node-drivers": "BAKERY_ORM_DRIVERS=node bun test --preload ./src/tests/sweep-preload.ts ./src",
    "test:node": "tsc -p tsconfig.build.json && node --test \"test/node/*.test.mjs\""
  },
  "peerDependencies": {
    "mysql2": "^3.24.5",
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "24.19.0",
    "mysql2": "3.24.5",
    "postgres": "3.4.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.22"
  }
}
